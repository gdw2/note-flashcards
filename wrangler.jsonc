{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-flashcards",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "flashcards.gdw2.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "note-flashcards",
      "database_id": "8f45bbe6-4735-4d94-9814-1925c2be66da"
    }
  ]
}
